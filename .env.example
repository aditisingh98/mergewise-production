# MergeWise environment variables (copy to .env for local/docker-compose)

# --- Required for production GitHub PR analysis ---
GITHUB_TOKEN=

# --- AI review (optional; heuristics still run without this) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OPENAI_MODEL=gemini-2.0-flash
OPENAI_MAX_PROMPT_CHARS=4000

# --- Deployment / public access ---
SPRING_PROFILES_ACTIVE=prod
PORT=8090
MERGEWISE_PUBLIC_URL=https://your-service.onrender.com
MERGEWISE_CORS_ORIGINS=https://your-frontend.com,http://localhost:3000

# --- Kafka (optional; disabled by default in production) ---
MERGEWISE_KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Platform auto-detection (set by host — do not set manually unless needed):
# RENDER_EXTERNAL_URL=
# RAILWAY_PUBLIC_DOMAIN=
